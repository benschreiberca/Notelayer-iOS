{
  "manifest_version": 3,
  "name": "Notelayer",
  "version": "0.1.0",
  "description": "Capture the current page as a Notelayer task and see your to-dos in a side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Notelayer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["identity", "storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "_comment_key": "Add a stable \"key\" here during development so the extension ID stays constant and matches your OAuth client. See README.md.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
