{
  "manifest_version": 3,
  "name": "Notelayer",
  "version": "1.0.0",
  "description": "Capture notes and tasks from the web — synced with your Notelayer app.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Notelayer",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://*.firebaseapp.com/*",
    "https://*.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "762003542605-REPLACE_WITH_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["email", "profile", "openid"]
  }
}
